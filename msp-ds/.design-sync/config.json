      "cardMode": "column"
    },
    "Grid12": {
      "cardMode": "column"
    },
    "SiteFooter": {
      "cardMode": "column"
    },
    "SiteNav": {
      "cardMode": "column"
    },
    "ApproachTimeline": {
      "cardMode": "column"
    },
    "CapabilityGrid": {
      "cardMode": "column"
    },
    "ContactLayout": {
      "cardMode": "column"
    },
    "CtaSection": {
      "cardMode": "column"
    },
    "IntelFeed": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
